# Supabase project (public values, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: where the restaurant is, for its clock and light (IANA name). Defaults to Asia/Kolkata.
# NEXT_PUBLIC_RESTAURANT_TIMEZONE=Asia/Kolkata

# KNAK's UPI account for payments (shown to guests). Until set, the payment page shows a sample code.
# NEXT_PUBLIC_UPI_ID=yourname@okaxis
# NEXT_PUBLIC_UPI_NAME=KNAK Grand Cafe
